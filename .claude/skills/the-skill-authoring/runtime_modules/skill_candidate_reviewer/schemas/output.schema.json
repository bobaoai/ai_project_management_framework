{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:skill_candidate_reviewer_output@v9",
  "title": "Skill Candidate Reviewer Output",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_ref",
        "locator",
        "observation"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "block",
            "fix",
            "note"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "accountable_owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "required_change": {
          "type": "string",
          "minLength": 1
        },
        "check_id": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "identity_discovery_class_and_source",
            "task_and_reader_gain",
            "entry_exit_and_routing",
            "inputs_authority_freshness_and_conflicts",
            "outputs_completion_failure_and_handoff",
            "boundaries_and_observable_violations",
            "method_result_certainty_and_agent_freedom",
            "design_and_revision_fidelity",
            "prompt_boundary_hygiene",
            "skill_agent_workflow_tool_separation",
            "runtime_ready_prompt_closure_if_declared",
            "prose_and_meaning_preservation"
          ]
        }
      },
      "required": [
        "finding_id",
        "severity",
        "evidence",
        "requirement",
        "impact",
        "accountable_owner_ref",
        "required_change",
        "check_id"
      ]
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "identity_discovery_class_and_source",
            "task_and_reader_gain",
            "entry_exit_and_routing",
            "inputs_authority_freshness_and_conflicts",
            "outputs_completion_failure_and_handoff",
            "boundaries_and_observable_violations",
            "method_result_certainty_and_agent_freedom",
            "design_and_revision_fidelity",
            "prompt_boundary_hygiene",
            "skill_agent_workflow_tool_separation",
            "runtime_ready_prompt_closure_if_declared",
            "prose_and_meaning_preservation"
          ]
        },
        "disposition": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "passed",
            "finding",
            "not_applicable",
            "not_run"
          ]
        },
        "assessment": {
          "type": "string",
          "minLength": 1
        },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "check_id",
        "disposition",
        "assessment",
        "finding_ids"
      ]
    }
  },
  "properties": {
    "verdict": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "passed",
        "non_pass",
        "blocked"
      ]
    },
    "check_results": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/check_result"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "safe_next_step": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "verdict",
    "check_results",
    "findings",
    "safe_next_step"
  ]
}
