{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:reviewer_reviewer_output@v2",
  "title": "Reviewer Reviewer Semantic Output",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_ref",
        "locator",
        "observation"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]{1,191}$"
        },
        "severity": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "block",
            "fix",
            "note"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "accountable_owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "required_change": {
          "type": "string",
          "minLength": 1
        },
        "finding_class": {
          "enum": [
            "task_or_reader_gain_gap",
            "input_decision_or_output_gap",
            "boundary_or_failure_routing_gap",
            "instruction_ownership_or_duplication",
            "cold_start_or_schema_fixture_conflict",
            "prose_or_meaning_risk"
          ],
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "finding_id",
        "severity",
        "evidence",
        "requirement",
        "impact",
        "accountable_owner_ref",
        "required_change",
        "finding_class"
      ]
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "purpose_subject_and_reader_gain",
            "inputs_decision_and_output",
            "boundaries_and_failure_routing",
            "instruction_ownership_and_nonduplication",
            "cold_start_executability_and_schema_fixture_consistency",
            "prose_and_meaning_preservation"
          ]
        },
        "disposition": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "passed",
            "finding",
            "not_applicable",
            "not_run"
          ]
        },
        "assessment": {
          "type": "string",
          "minLength": 1
        },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_.-]{1,191}$"
          }
        }
      },
      "required": [
        "check_id",
        "disposition",
        "assessment",
        "finding_ids"
      ]
    }
  },
  "properties": {
    "verdict": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "passed",
        "non_pass",
        "blocked"
      ]
    },
    "check_results": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/check_result"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "safe_next_step": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "verdict",
    "check_results",
    "findings",
    "safe_next_step"
  ]
}
