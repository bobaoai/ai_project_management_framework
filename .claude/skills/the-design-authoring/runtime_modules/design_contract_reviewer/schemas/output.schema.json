{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:design_contract_reviewer_output@v8",
  "title": "Design Contract Reviewer Semantic Output",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_ref",
        "locator",
        "observation"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]{1,191}$"
        },
        "severity": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "block",
            "fix",
            "note"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "accountable_owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "required_change": {
          "type": "string",
          "minLength": 1
        },
        "finding_class": {
          "enum": [
            "intent_gap",
            "layer_or_owner_defect",
            "layer_content_misfit",
            "peer_or_inheritance_conflict",
            "boundary_ambiguity",
            "code_truth_leakage",
            "flow_or_interface_closure_gap",
            "failure_or_completion_gap",
            "implementability_gap",
            "review_or_admission_conflict",
            "prose_or_communication_defect"
          ],
          "type": "string",
          "minLength": 1
        },
        "affected_candidate_document_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,191}$",
          "minLength": 1
        },
        "correction_target_document_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,191}$",
          "minLength": 1
        }
      },
      "required": [
        "finding_id",
        "severity",
        "evidence",
        "requirement",
        "impact",
        "accountable_owner_ref",
        "required_change",
        "finding_class",
        "affected_candidate_document_id",
        "correction_target_document_id"
      ]
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "intent_and_reader_result",
            "layer_owner_and_parent",
            "layer_content_fit",
            "peer_authority_and_inheritance",
            "boundary_coherence",
            "design_and_code_truth_separation",
            "flow_interface_and_error_closure",
            "failure_completion_and_rollback",
            "implementability_without_redesign",
            "review_approval_and_admission",
            "prose_and_meaning_preservation"
          ]
        },
        "disposition": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "passed",
            "finding",
            "not_applicable",
            "not_run"
          ]
        },
        "assessment": {
          "type": "string",
          "minLength": 1
        },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_.-]{1,191}$"
          }
        }
      },
      "required": [
        "check_id",
        "disposition",
        "assessment",
        "finding_ids"
      ]
    }
  },
  "properties": {
    "verdict": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "passed",
        "non_pass",
        "blocked"
      ]
    },
    "check_results": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "$ref": "#/$defs/check_result"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "safe_next_step": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "verdict",
    "check_results",
    "findings",
    "safe_next_step"
  ]
}
