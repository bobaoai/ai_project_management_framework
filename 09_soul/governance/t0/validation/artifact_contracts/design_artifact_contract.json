  "reviewer_checklist": {
    "resource_id": "t0:design_contract_review_checklist",
    "intro_lines": [],
    "columns": [
      "顺序",
      "`check_id`",
      "必须确定的结果",
      "`finding_class`"
    ],
    "checks": [
      {
        "order": 1,
        "check_id": "intent_and_reader_result",
        "required_result": "Intended Outcomes 覆盖授权范围内本层每项主要能力的预期结果及必要质量，说明使用情境和接收方用途，保留目的依据与适用边界。对照主要能力及全部后文要求，确认重要结果没有遗漏或只出现在后文；不能仅列产物名称或空泛质量词。不以条数、篇幅或逐项同名判断完整性，不要求搬入局部实现细节。读者理解或指定过程不能替代系统结果，无证据的结论或后续工作不能成为当前承诺。",
        "finding_class": "intent_gap",
        "stage": "semantic"
      },
      {
        "order": 2,
        "check_id": "layer_owner_and_parent",
        "required_result": "层级、负责人和必要父级清楚。本次结果涉及的职责没有重叠或缺口，也没有为了检查完整性而重整全部邻接系统。",
        "finding_class": "layer_or_owner_defect",
        "stage": "semantic"
      },
      {
        "order": 3,
        "check_id": "layer_content_fit",
        "required_result": "内容属于本层，所选模块承担明确的内容职责。机制按实际需要使用，没有为填满标题而增加下层设计。",
        "finding_class": "layer_content_misfit",
        "stage": "semantic"
      },
      {
        "order": 4,
        "check_id": "peer_authority_and_inheritance",
        "required_result": "设计遵守适用上游规则，与直接相关同级系统的交接一致。实际涉及时间或机器引用语义时，遵守对应 T0。",
        "finding_class": "peer_or_inheritance_conflict",
        "stage": "semantic"
      },
      {
        "order": 5,
        "check_id": "boundary_coherence",
        "required_result": "主要职责有明确执行主体、处理对象和动作。交接写清结果、接收方及其后续工作。文档负责人不替代执行主体，职责区分不创造多余管理角色。",
        "finding_class": "boundary_ambiguity",
        "stage": "semantic"
      },
      {
        "order": 6,
        "check_id": "design_and_code_truth_separation",
        "required_result": "文稿区分目标与实际实现，当前事实有代码依据，不额外要求没有消费需要的机器对象。",
        "finding_class": "code_truth_leakage",
        "stage": "semantic"
      },
      {
        "order": 7,
        "check_id": "flow_interface_and_error_closure",
        "required_result": "流程图、正文、实际需要的输入输出和失败处理一致。材料交接没有被误写成软件接口。",
        "finding_class": "flow_or_interface_closure_gap",
        "stage": "semantic"
      },
      {
        "order": 8,
        "check_id": "failure_completion_and_rollback",
        "required_result": "完成、信息不足和真实失败的后果清楚。恢复或回滚只在实际影响需要时定义。",
        "finding_class": "failure_or_completion_gap",
        "stage": "semantic"
      },
      {
        "order": 9,
        "check_id": "implementability_without_redesign",
        "required_result": "本层已决定实际情境中的主要功能、工作方式和交付结果，接手者无需重新猜测。实质功能歧义按设计缺口处理，不降为文字建议。合理下层选择和不影响本步的后续工作仍被保留。",
        "finding_class": "implementability_gap",
        "stage": "semantic"
      },
      {
        "order": 10,
        "check_id": "review_approval_and_admission",
        "required_result": "审核、实现和采用分别有对应证据，所需授权清楚，没有新增不必要的状态或重复审批。",
        "finding_class": "review_or_admission_conflict",
        "stage": "semantic"
      },
      {
        "order": 11,
        "check_id": "prose_and_meaning_preservation",
        "required_result": "语义要求成立后，没有聊天背景的读者能准确理解设计。文字修正保留事实、职责和条件。",
        "finding_class": "prose_or_communication_defect",
        "stage": "prose"
      }
    ],
    "outro_lines": []
  },
  "forbidden_headings": [
    "User Intent",
    "Reader Gain"
  ]
}
